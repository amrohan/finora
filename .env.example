# ==============================================================================
# Finora Environment Variables Template
# Copy this file to .env or inject these variables in your deployment environment.
# NEVER commit production secrets or real credentials to source control.
# ==============================================================================

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
TZ=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Database Configuration (Supabase PostgreSQL)
# Format: Host=aws-0-ap-south-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true;
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=finora;Username=postgres;Password=your_strong_password_here;SSL Mode=Prefer;

# ASP.NET Core Identity & Security Configuration
# Minimum 32-character high-entropy secret for token signing
JWT_SECRET=your_minimum_32_character_super_secret_key_here
JWT_ISSUER=https://api.finora.internal
JWT_AUDIENCE=https://finora.internal
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Registration Security
# Seed token required to create the first household admin
INITIAL_SETUP_TOKEN=replace_with_a_secure_one_time_token

# CORS & Client Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,https://app.finora.internal
FRONTEND_URL=http://localhost:4200
BACKEND_API_URL=http://localhost:5000

# Logging & Monitoring
LOG_LEVEL=Information
ENABLE_SENSITIVE_DATA_LOGGING=false

# Backup Configuration (VPS automation)
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/finora
BACKUP_ENCRYPTION_PASSPHRASE=replace_with_strong_backup_encryption_passphrase

