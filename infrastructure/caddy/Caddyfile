# Caddyfile: Production Reverse Proxy & SSL Configuration for Finora
{
    # Global options
    auto_https disable_redirects
}

:80, :443 {
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; manifest-src 'self';"
    }

    # API Reverse Proxy
    handle /api/* {
        reverse_proxy api:5000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API Health Check Endpoint
    handle /health {
        reverse_proxy api:5000
    }

    # Static Angular SPA & Progressive Web App (PWA)
    handle {
        root * /var/www/finora
        try_files {path} /index.html
        file_server

        # Immutable caching for hashed JS/CSS/Fonts
        @static path *.js *.css *.woff2 *.svg *.png *.ico
        header @static Cache-Control "public, max-age=31536000, immutable"

        # Never cache index.html, service worker, or web manifest
        @nocache path /index.html /sw.js /manifest.webmanifest
        header @nocache Cache-Control "no-cache, no-store, must-revalidate"
    }
}

